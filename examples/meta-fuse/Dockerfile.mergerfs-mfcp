# mergerfs sidecar for meta-fuse fusermount3-proxy validation (Track B)
# renovate: datasource=github-releases depName=trapexit/mergerfs
ARG MERGEFS_VERSION=2.42.0

FROM golang:1.22-bookworm AS proxy-build
WORKDIR /src
RUN git clone --depth 1 https://github.com/pfnet-research/meta-fuse-csi-plugin.git .
RUN make fusermount3-proxy BINDIR=/out

FROM debian:bookworm-slim
ARG MERGEFS_VERSION
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl fuse3 libfuse2 \
    && echo user_allow_other >> /etc/fuse.conf \
    && rm -f /usr/bin/fusermount /usr/bin/fusermount3 \
    && rm -rf /var/lib/apt/lists/*
RUN case "${TARGETARCH}" in amd64) ARCH=amd64 ;; arm64) ARCH=arm64 ;; *) ARCH=amd64 ;; esac \
 && curl -fsSL "https://github.com/trapexit/mergerfs/releases/download/${MERGEFS_VERSION}/mergerfs-${MERGEFS_VERSION}-static-linux_${ARCH}.tar.gz" \
      -o /tmp/m.tgz \
 && tar -xzf /tmp/m.tgz -C /tmp \
 && install -m 0755 /tmp/usr/local/bin/mergerfs /usr/local/bin/mergerfs \
 && rm -rf /tmp/m.tgz /tmp/usr /tmp/sbin
# Do NOT ship setuid mergerfs-fusermount — proxy replaces fusermount chain.
COPY --from=proxy-build /out/fusermount3-proxy /usr/local/bin/fusermount3-proxy
RUN ln -sf /usr/local/bin/fusermount3-proxy /usr/local/bin/fusermount3 \
 && ln -sf /usr/local/bin/fusermount3-proxy /usr/local/bin/fusermount \
 && ln -sf /usr/local/bin/fusermount3-proxy /usr/local/bin/mergerfs-fusermount
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
