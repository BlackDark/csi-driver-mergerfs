{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>trapexit/mergerfs)\\s+ARG MERGEFS_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver"
    }
  ]
}
